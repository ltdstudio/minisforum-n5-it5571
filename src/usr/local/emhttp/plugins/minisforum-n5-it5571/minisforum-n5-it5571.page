<script>
// Live refresh: poll the standalone JSON endpoint every 3s, update in place.
(function () {
  var url = '/plugins/minisforum-n5-it5571/minisforum-n5-it5571.php';
  function refresh() {
    fetch(url, { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d.loaded) return;
      var hw = document.getElementById('hwmon-id');
      if (hw && d.hwmon) hw.textContent = d.hwmon;
      var rows = document.querySelectorAll('#pwm-table tbody tr');
      d.pwm.forEach(function (p, i) {
        var tr = rows[i]; if (!tr) return;
        var pwm = tr.querySelector('.pwm'); if (pwm) pwm.textContent = (p.pwm ?? '—') + ' / 255';
        var fan = tr.querySelector('.fan'); if (fan) fan.textContent = p.fan !== null ? p.fan + ' RPM' : '—';
        var mode = tr.querySelector('.mode');
        if (mode) mode.innerHTML = p.mode === 'manual' ? '<span class="badge manual">手动 / 被其他软件接管 Manual / Software takeover</span>'
          : (p.mode === 'bios' ? '<span class="badge bios">EC/BIOS 自动 Auto</span>' : '—');
      });
      var trows = document.querySelectorAll('#temp-table tbody tr');
      d.temp.forEach(function (t, i) {
        var tr = trows[i]; if (!tr) return;
        var v = (t !== null && typeof t === 'object') ? t.c : t; // 兼容 {c} 与纯数字
        var tv = tr.querySelector('.tval'); if (tv) tv.textContent = v;
        var b = tr.querySelector('.badge');
        if (b) { b.textContent = v >= 80 ? '过热 HOT' : '正常 OK';
          b.className = 'badge ' + (v >= 80 ? 'warn' : 'ok'); }
      });
    }).catch(function () { /* transient; retry next tick */ });
  }
  setInterval(refresh, 3000);
  setTimeout(refresh, 500); // quick first poll
})();
</script>
</body>
</html>
