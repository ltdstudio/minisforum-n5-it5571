Icon="minisforum-n5-it5571.png"
Title="Minisforum N5 EC / IT5571 Driver"
---
<?PHP
/* Minisforum N5 EC / IT5571 Driver — sensor status page
 * Reads hwmon sysfs nodes exported by minisforum_n5_it5571 directly.
 * Theme-aware: follows the Unraid WebGUI light/dark appearance.
 * GPL-2.0-only
 */
$plugin = 'minisforum-n5-it5571';

function hwmon_path() {
  foreach (glob('/sys/class/hwmon/hwmon*') ?: [] as $d) {
    $name = @file_get_contents("$d/name");
    if (trim($name) === 'minisforum_n5_it5571') return $d;
  }
  return false;
}

function read_attr($base, $attr) {
  $v = @file_get_contents("$base/$attr");
  return $v === false ? null : trim($v);
}

$h = hwmon_path();
$module_loaded = is_dir($h);

$pwm_map = [1 => 'CPU Fan', 2 => 'SSD Fan', 3 => 'HDD Fan Group', 4 => 'PCIe Fan'];
$temp_map = [1 => 'CPU Temp', 2 => 'System Temp', 3 => 'Board Temp', 4 => 'Ambient Temp'];

$pwm_rows = [];
for ($i = 1; $i <= 4; $i++) {
  if (!$module_loaded) break;
  $pwm = read_attr($h, "pwm$i");
  $enable = read_attr($h, "pwm${i}_enable");
  $fan = read_attr($h, "fan${i}_input");
  $mode = match ($enable) {
    '1' => 'manual',
    '2' => 'bios',
    default => null,
  };
  $pwm_rows[] = ['ch' => $i, 'label' => $pwm_map[$i] ?? "PWM $i", 'pwm' => $pwm, 'mode' => $mode, 'fan' => $fan];
}

$temp_rows = [];
for ($i = 1; $i <= 4; $i++) {
  if (!$module_loaded) break;
  $t = read_attr($h, "temp${i}_input");
  if ($t !== null) {
    $temp_rows[] = ['label' => $temp_map[$i] ?? "Temp $i", 'c' => round($t / 1000, 1)];
  }
}
?>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
/* Theme-aware: use CSS variables that follow the Unraid WebGUI palette */
:root {
  --pg-bg: var(--body-bg, #ffffff);
  --pg-fg: var(--font-color, #1d1b1b);
  --pg-muted: var(--muted-color, #6b7280);
  --pg-card-bg: var(--card-bg, #f3f4f6);
  --pg-border: var(--card-border, #e5e7eb);
  --pg-accent: var(--blue-500, #3b82f6);
  --pg-hot: var(--red-500, #ef4444);
  --pg-ok: var(--green-500, #22c55e);
}
@media (prefers-color-scheme: dark) {
  :root {
    --pg-bg: #1a2233;
    --pg-fg: #e8edf5;
    --pg-muted: #8fa0bd;
    --pg-card-bg: #222c42;
    --pg-border: #31405f;
    --pg-accent: #7dd3fc;
    --pg-hot: #f87171;
    --pg-ok: #4ade80;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 24px;
  background: var(--pg-bg);
  color: var(--pg-fg);
  font-family: "Helvetica Neue", Arial, sans-serif;
}
h1 { font-size: 20px; margin: 0 0 4px; color: var(--pg-fg); }
.sub { color: var(--pg-muted); font-size: 12px; margin-bottom: 20px; }
.card {
  background: var(--pg-card-bg);
  border: 1px solid var(--pg-border);
  border-radius: 8px;
  padding: 16px 18px;
  margin-bottom: 16px;
}
.card h2 { font-size: 14px; margin: 0 0 12px; color: var(--pg-accent); letter-spacing: .5px; }
table { width: 100%; border-collapse: collapse; }
th, td {
  text-align: left; padding: 7px 10px; font-size: 13px;
  border-bottom: 1px solid var(--pg-border);
  color: var(--pg-fg);
}
th { color: var(--pg-muted); font-weight: 600; font-size: 12px; }
td.num { font-family: Menlo, monospace; }
.badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
.badge.bios { background: #1d4ed8; color: #bfdbfe; }
.badge.manual { background: #b45309; color: #fde68a; }
.badge.ok { color: var(--pg-ok); }
.badge.warn { color: var(--pg-hot); }
.note { font-size: 12px; color: var(--pg-muted); }
.warnbox {
  background: color-mix(in srgb, var(--pg-hot) 12%, var(--pg-bg));
  border: 1px solid var(--pg-hot);
  border-radius: 8px;
  padding: 14px 18px;
  margin-bottom: 16px;
  color: var(--pg-hot);
  font-size: 13px;
}
tt { background: var(--pg-card-bg); padding: 1px 5px; border-radius: 4px; }
</style>
</head>
<body>
<h1>Minisforum N5 EC / IT5571 Driver</h1>
<div class="sub">Kernel module: minisforum_n5_it5571 &nbsp;·&nbsp; hwmon: <?= $module_loaded ? basename($h) : 'not loaded' ?></div>

<? if (!$module_loaded): ?>
  <div class="warnbox">⚠ The <b>minisforum_n5_it5571</b> kernel module is not loaded.
  Check <tt>dmesg | grep -i minisforum</tt> and the plugin installation log.</div>
<? else: ?>

<div class="card">
<h2>Fan Channels</h2>
<table>
<tr><th>Channel</th><th>PWM</th><th>Mode</th><th>RPM</th></tr>
<? foreach ($pwm_rows as $r): ?>
<tr>
  <td><?= htmlspecialchars($r['label']) ?></td>
  <td class="num"><?= $r['pwm'] ?? '—' ?> / 255</td>
  <td><?= $r['mode'] === 'manual' ? '<span class="badge manual">MANUAL</span>' : ($r['mode'] === 'bios' ? '<span class="badge bios">EC/BIOS AUTO</span>' : 'n/a') ?></td>
  <td class="num"><?= $r['fan'] !== null ? $r['fan'].' RPM' : 'n/a' ?></td>
</tr>
<? endforeach; ?>
</table>
<div class="note">PCIe Fan has no RPM feedback on this board — zero is expected.</div>
</div>

<div class="card">
<h2>Temperatures</h2>
<table>
<tr><th>Sensor</th><th>Value</th></tr>
<? foreach ($temp_rows as $r): ?>
<tr>
  <td><?= htmlspecialchars($r['label']) ?></td>
  <td class="num"><?= $r['c'] ?> °C
    <span class="badge <?= $r['c'] >= 80 ? 'warn' : 'ok' ?>"><?= $r['c'] >= 80 ? 'HOT' : 'OK' ?></span>
  </td>
</tr>
<? endforeach; ?>
</table>
</div>

<? endif; ?>

<div class="note">Fan control: use <b>FanCtrl Plus 2</b> (recommended) or Dynamix Fan Auto Control.
Assign each PWM to one controller only. Module unload restores EC automatic mode.</div>
</body>
</html>
